{
  "name": "ali-mapari-portfolio",
  "version": "1.0.0",
  "description": "Ali Mapari Portfolio — Swiss Editorial & WebGL Cyberpunk built with Tailwind CSS v4 CLI",
  "main": "index.html",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./style.css --watch",
    "build:webgl:css": "npx @tailwindcss/cli -i ./src/webgl-input.css -o ./webgl/style.css --minify",
    "watch:webgl:css": "npx @tailwindcss/cli -i ./src/webgl-input.css -o ./webgl/style.css --watch",
    "build:all": "npm run build:css && npm run build:webgl:css"
  },
  "keywords": [
    "portfolio",
    "tailwind-v4",
    "swiss-editorial",
    "webgl-cyberpunk"
  ],
  "author": "Ali Mapari",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
